// ==========================================
// 뭔말인교? (mwonmalingyo) - 데이터 모델 (ERD)
// 판교어 해석 + 간격 반복 학습 서비스
// 제출 파일명: {반}_{이름}_뭔말인교-DB.dbml
// 2026-09-16
// ==========================================

Project mwonmalingyo {
  database_type: 'MySQL'
  Note: '''
  프로젝트(projects) 안의 회의(meetings), 메시지에서 판교어를 쉬운 말로 해석하고(translations),
  해석에서 만난 용어를 학습 카드로 만들어(cards),
  망각곡선에 맞춰 복습시키고(review_sessions/review_logs),
  판교어 실력 테스트로 등급을 부여하는(quiz_sessions) 서비스의 데이터 모델.
  판교어 사전(terms, term_examples)은 운영자가 시드 데이터로 넣고, 사용자는 조회만 합니다.
  로그인은 소셜 로그인(Apple, Google, 카카오)만 지원하며, 화면이 없는 기능은 범위에서 제외했습니다.
  '''
}

// ==========================================
// Enum (상수 및 상태값 정의)
// ==========================================
Enum user_role {
  MEMBER [note: '일반 사용자 (학습자)']
  ADMIN  [note: '운영자 계정 구분 - 판교어 사전 시드 데이터 등록, 별도 관리 화면 없음']
}

Enum auth_provider {
  APPLE  [note: 'Sign in with Apple']
  GOOGLE [note: 'Google OAuth 2.0']
  KAKAO  [note: '카카오 OAuth 2.0']
}

Enum input_source {
  TYPED      [note: '직접 입력 / 붙여넣기']
  SCREENSHOT [note: '스크린샷 업로드 후 OCR로 글자 추출']
  RECORDING  [note: '웹에서 회의 녹음 → 텍스트 변환 (v5)']
  EXTENSION  [note: '브라우저 확장에서 드래그 전송 (향후)']
}

Enum device_platform {
  IOS [note: 'iOS 앱 - 알림, 복습']
  WEB [note: '웹 (현재 푸시 토큰은 IOS만 등록)']
}

Enum notification_type {
  REVIEW_REMINDER [note: '퇴근길 복습 알림 (reminder_hour)']
  ACTION_DUE      [note: '할 일 마감 알림']
  DECODE_DONE     [note: '해석/녹음 변환 완료 → iOS 푸시']
  LEVEL_UP        [note: '판교어 실력 테스트 등급 업 (A-08) → iOS 푸시']
}

Enum recording_status {
  RECORDING    [note: '녹음 중, 1분 조각이 올라오며 transcript 부분 갱신']
  UPLOADED     [note: '업로드 완료']
  TRANSCRIBING [note: '텍스트 변환 중']
  DONE         [note: '변환, 해석 완료']
  FAILED       [note: '실패']
}

Enum source_type {
  MESSAGE      [note: '짧은 메시지 1건 - 슬랙/메일 (최대 500자)']
  MEETING_NOTE [note: '회의 녹음 변환 텍스트 전체 - 요약 + 할 일 추출 (최대 5000자)']
}

Enum term_status {
  APPROVED [note: '노출 - 사전/해석/실력 테스트에 사용 (기본값)']
  HIDDEN   [note: '운영자가 숨김 처리']
}

Enum term_category {
  WORK    [note: '업무 진행 - 얼라인, 팔로업']
  DATA    [note: '지표 - 리텐션, 퍼널']
  DEV     [note: '개발 - 디플로이, 핫픽스']
  ORG     [note: '조직/직무 - 올라운더, 오너십']
  MEETING [note: '회의 - 아젠다, 레슨런']
  ETC     [note: '기타']
}

Enum translation_direction {
  JARGON_TO_PLAIN [note: '판교어 -> 쉬운 말']
  PLAIN_TO_JARGON [note: '쉬운 말 -> 판교어']
}

Enum intent_type {
  REQUEST  [note: '요청 - 나에게 일을 시킴']
  DECISION [note: '결정 통보 - 제안형이지만 이미 정해짐']
  DECLINE  [note: '완곡한 거절 - "챌린지가 있을 것 같다"']
  SHARE    [note: '단순 공유 - 액션 없음']
  QUESTION [note: '질문 - 답변 필요']
}

Enum card_status {
  LEARNING [note: '학습 중 (복습 간격 21일 미만)']
  MASTERED [note: '마스터 (복습 간격 21일 이상)']
  PAUSED   [note: '잠시 멈춤 - 복습 대상에서 제외']
}

Enum review_rating {
  AGAIN [note: '다시 - 못 떠올림, 간격 초기화']
  HARD  [note: '애매 - 간격 소폭 증가']
  GOOD  [note: '좋음 - 정상 간격 증가']
  EASY  [note: '완벽 - 간격 크게 증가']
}

// ==========================================
// Core Entities (핵심 개체)
// ==========================================

Table levels {
  code            varchar(20)  [pk, note: '판교어 실력 테스트 등급 코드']
  name            varchar(30)  [not null, note: '외지인 / 관광객 / 이주민 / 원주민 / 토박이 (5단계)']
  min_score       int          [not null, note: '0 / 20 / 40 / 65 / 85']
  max_score       int          [not null, note: '19 / 39 / 64 / 84 / 100']
  badge_image_url varchar(500) [note: '등급 배지 이미지']
  sort_order      int          [not null, default: 0]

  Note: '판교 등급 마스터 5단계 (OUTSIDER/TOURIST/SETTLER/NATIVE/LOCAL). A-01 홈 진행률, A-08 결과, A-09 MY, S-00-5 사다리에 사용'
}

Table users {
  id             bigint        [pk, increment]
  email          varchar(255)  [not null, unique, note: '소셜 제공자에서 받은 이메일']
  provider       auth_provider [not null, note: '가입 경로 (소셜 로그인만 지원)']
  provider_id    varchar(255)  [not null, note: 'OAuth 제공자가 준 고유 ID (sub)']
  profile_image_url varchar(500) [note: 'OAuth 프로필 이미지']
  nickname       varchar(30)   [not null, unique]
  job_group      varchar(30)   [note: '개발/기획/디자인/영업/HR/기타 (API JobGroup enum) - 온보딩에서 수집']
  onboarded_at   datetime      [note: 'NULL이면 로그인 후 온보딩(S-00-1)으로 보냄']
  reminder_hour  int           [not null, default: 18, note: '퇴근길 복습 알림 시각 0~23 (온보딩 S-00-3)']
  action_alert_enabled boolean [not null, default: true, note: '할 일 마감 알림 on/off']
  role           user_role     [not null, default: 'MEMBER', note: '운영자 계정 구분']
  level_code     varchar(20)  [note: '최신 판교어 실력 테스트 등급 OUTSIDER/TOURIST/SETTLER/NATIVE/LOCAL (NULL = 미응시)']
  best_score     int          [not null, default: 0, note: '판교어 실력 테스트 최고 점수 0~100']
  current_streak int          [not null, default: 0, note: '연속 복습 일수 - 홈 화면 🔥']
  longest_streak int          [not null, default: 0]
  last_review_at date         [note: '마지막 복습 날짜 - 스트릭 계산용']
  current_project_id bigint   [note: '마지막으로 고른 프로젝트 (웹, 앱 공통)']
  created_at     datetime     [not null, default: `now()`]
  updated_at     datetime     [not null, default: `now()`]

  indexes {
    email [unique, name: 'ux_users_email']
    nickname [unique, name: 'ux_users_nickname']
    (provider, provider_id) [unique, name: 'ux_users_provider']
    level_code [name: 'ix_users_level']
  }
  Note: '서비스 회원. 소셜 로그인으로 가입하며 role은 운영자 계정 구분용'
}

Table terms {
  id             bigint        [pk, increment]
  slug           varchar(100)  [not null, unique, note: 'URL 식별자 - align, retention']
  term_ko        varchar(100)  [not null, note: '판교어 표기 - 얼라인']
  origin_en      varchar(100)  [note: '원어 - align']
  plain_ko       varchar(200)  [not null, note: '쉬운 우리말 - 방향 맞추기']
  meaning        varchar(1000) [not null, note: '상세 뜻풀이']
  category       term_category [not null, default: 'ETC']
  status         term_status   [not null, default: 'APPROVED']
  created_by     bigint        [not null, note: '등록한 운영자']
  reviewed_by    bigint        [note: '검수한 운영자']
  reviewed_at    datetime
  view_count     int           [not null, default: 0]
  created_at     datetime      [not null, default: `now()`]
  updated_at     datetime      [not null, default: `now()`]

  indexes {
    term_ko [name: 'ix_terms_term_ko']
    (status, category) [name: 'ix_terms_status_category']
    created_by [name: 'ix_terms_created_by']
  }
  Note: '판교어 사전의 핵심 엔터티. 운영자가 시드 데이터로 등록하고 사용자는 조회만 함 (해석 결과의 용어 뜻 미리보기)'
}

Table term_examples {
  id              bigint       [pk, increment]
  term_id         bigint       [not null]
  sentence_jargon varchar(500) [not null, note: '판교어 문장 - 노란 하이라이트']
  sentence_plain  varchar(500) [not null, note: '쉬운 말 문장 - 민트 하이라이트']
  created_by      bigint       [not null, note: '등록한 운영자']
  created_at      datetime     [not null, default: `now()`]

  indexes {
    term_id [name: 'ix_term_examples_term']
  }
  Note: '1:N - 용어 하나에 예문 여러 개 (A-04 복습 뒷면 예문)'
}

// ==========================================
// Learning (간격 반복 학습 - 서비스 핵심)
// ==========================================

Table cards {
  id                bigint       [pk, increment]
  user_id           bigint       [not null]
  term_id           bigint       [not null]
  source_translation_id bigint   [note: '처음 담긴 해석 - 프로젝트, 회의별 모르는 말 필터의 기준']
  status            card_status  [not null, default: 'LEARNING']
  memo              varchar(300) [note: '내 메모 - "팀장님이 제일 많이 쓰는 말"']
  interval_days     int          [not null, default: 0, note: '현재 복습 간격(일)']
  ease_factor       decimal(4,2) [not null, default: 2.50, note: '난이도 계수 1.30~2.50 (SM-2)']
  repetition_count  int          [not null, default: 0, note: '연속 정답 횟수']
  lapse_count       int          [not null, default: 0, note: 'AGAIN 누른 횟수']
  due_date          date         [not null, note: '다음 복습 예정일 - 홈의 오늘 복습 N장 기준']
  last_reviewed_at  datetime     [note: '마지막 복습 시각']
  created_at        datetime     [not null, default: `now()`]

  indexes {
    (user_id, term_id) [unique, name: 'ux_cards_user_term']
    (user_id, due_date) [name: 'ix_cards_due']
    (user_id, status) [name: 'ix_cards_status']
    source_translation_id [name: 'ix_cards_source_translation']
  }
  Note: 'M:N (users <-> terms) + 학습 상태 속성. 모르는 말(서비스 전체 단어장)이자 복습 대상 (W-05, A-03)'
}

Table review_sessions {
  id              bigint   [pk, increment]
  user_id         bigint   [not null]
  target_count    int      [not null, note: '시작 시 due 카드 수']
  completed_count int      [not null, default: 0]
  good_count      int      [not null, default: 0, note: 'GOOD 이상 평가 수 - 정확도 계산']
  started_at      datetime [not null, default: `now()`]
  finished_at     datetime [note: 'NULL = 진행 중 (이어서 복습 가능)']

  indexes {
    (user_id, started_at) [name: 'ix_review_sessions_user_time']
  }
  Note: '복습 1회 = 1행 (A-03, A-04). 복습 결과 조회의 원천'
}

Table review_logs {
  id                bigint        [pk, increment]
  review_session_id bigint        [not null]
  card_id           bigint        [not null]
  rating            review_rating [not null, note: '다시/애매/좋음/완벽']
  prev_interval     int           [not null, note: '복습 전 간격(일)']
  next_interval     int           [not null, note: '복습 후 계산된 간격(일)']
  elapsed_ms        int           [note: '답을 떠올리는 데 걸린 시간']
  reviewed_at       datetime      [not null, default: `now()`]

  indexes {
    review_session_id [name: 'ix_review_logs_session']
    card_id [name: 'ix_review_logs_card']
  }
  Note: '1:N - 세션 하나에 카드별 복습 기록. 학습 통계(A-01, A-09)의 원천 데이터'
}

// ==========================================
// Project, Meeting, Translation (AI 해석 - 서비스 진입점)
// ==========================================

Table projects {
  id          bigint       [pk, increment]
  user_id     bigint       [not null]
  name        varchar(40)  [not null, note: '프로젝트 코드명 - "루나"']
  description varchar(60)  [note: '"고객센터 챗봇"']
  color       varchar(7)   [not null, default: '#2F6FD6']
  is_default  boolean      [not null, default: false, note: '온보딩에서 건너뛰면 자동 생성되는 "내 프로젝트"']
  created_at  datetime     [not null, default: `now()`]
  updated_at  datetime     [note: '이름, 색 변경 시각 - lastActivityAt 계산 보조']

  indexes {
    (user_id, name) [unique, name: 'ux_projects_user_name']
  }
  Note: '가장 큰 단위, 회의, 해석, 할 일이 모두 프로젝트 안에 속함'
}

Table meetings {
  id              bigint        [pk, increment]
  project_id      bigint        [not null]
  user_id         bigint        [not null, note: '만든 사람']
  title           varchar(100)  [not null, note: '"스프린트 계획 회의"']
  held_at         datetime      [not null, note: '회의 일시']
  attendee_count  int           [not null, default: 1]
  agenda          varchar(200)
  created_at      datetime      [not null, default: `now()`]

  indexes {
    (project_id, held_at) [name: 'ix_meetings_project_time']
    user_id [name: 'ix_meetings_user']
  }
  Note: '회의 = 회의록. 안에서 녹음(meeting_recordings)과 해석(translations)이 쌓임, W-07, A-12'
}

Table translations {
  id               bigint                [pk, increment]
  user_id          bigint                [not null, note: '해석한 사용자 (비로그인 체험은 저장하지 않음)']
  project_id       bigint                [not null, note: '소속 프로젝트 (요청에 없으면 현재 프로젝트)']
  meeting_id       bigint                [note: '붙은 회의 - NULL이면 회의 밖 해석']
  direction        translation_direction [not null]
  source_type      source_type           [not null, default: 'MESSAGE', note: '메시지 1건 vs 회의록 전체']
  source_text      varchar(5000)         [not null, note: '입력 원문 (MESSAGE는 500자, MEETING_NOTE는 5000자 제한)']
  input_source     input_source          [not null, default: 'TYPED', note: '어떻게 입력됐는지 - 직접입력/스크린샷/녹음/확장']
  source_image_url varchar(500)          [note: '스크린샷 입력일 때 원본 이미지']
  ocr_confidence   decimal(4,3)          [note: 'OCR 인식 신뢰도 - 낮으면 화면에 "글자 확인해 주세요" 경고']
  result_text      varchar(2000)         [not null, note: '쉬운 말 해석 결과']
  summary          varchar(1000)         [note: '회의록일 때만 - 3줄 요약']
  jargon_count     int                   [not null, default: 0, note: '0 이면 청정 한국어 빈 상태']
  intent_type      intent_type           [note: '문장의 실제 의도 - 뉘앙스 해석 결과']
  nuance_note      varchar(500)          [note: '숨은 뜻 설명 - "제안형이지만 실제로는 결정 통보"']
  nuance_tip       varchar(300)          [note: '대응 팁 - "되묻기보다 일정만 확인하는 편이 안전"']
  nuance_confidence decimal(4,3)         [note: 'AI 뉘앙스 판단 신뢰도 0.000~1.000']
  ai_model         varchar(50)           [not null, note: '예: claude-opus-5']
  latency_ms       int
  created_at       datetime              [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'ix_translations_user_time']
    (project_id, meeting_id, created_at) [name: 'ix_translations_project_meeting']
    meeting_id [name: 'ix_translations_meeting']
  }
  Note: '해석 기록 (W-01, W-03, A-06). meeting_id가 NULL이면 「메시지 해석」. 쉬운 말 + 뉘앙스가 여기, 할 일은 translation_actions 에'
}

Table translation_actions {
  id             bigint       [pk, increment]
  translation_id bigint       [not null]
  sort_order     int          [not null, note: '할 일 순번 1, 2, 3...']
  action_text    varchar(300) [not null, note: '내가 해야 할 일 - "담당자별 역할 정리 문서 만들기"']
  due_hint       varchar(100) [note: '원문에서 읽어낸 기한 힌트 - "다음 스프린트 시작 전"']
  is_checked     boolean      [not null, default: false, note: '사용자가 완료 체크했는지']
  alert_enabled  boolean      [not null, default: true, note: '마감 30분 전 푸시 (W-03 스위치)']
  due_at         datetime     [note: '알림 기준 시각 (due_hint를 해석한 값)']
  checked_at     datetime
  created_at     datetime     [not null, default: `now()`]

  indexes {
    (translation_id, sort_order) [unique, name: 'ux_actions_translation_order']
    (is_checked, created_at) [name: 'ix_actions_checked']
    (alert_enabled, due_at) [name: 'ix_actions_due_alert']
  }
  Note: '1:N - 해석 1건에서 추출된 할 일 목록. 홈(A-01), 프로젝트(W-00), 회의(W-07, A-12) 할 일의 원천'
}

Table translation_terms {
  id             bigint       [pk, increment]
  translation_id bigint       [not null]
  term_id        bigint       [note: 'NULL = 사전에 없는 신규 판교어 (AI 해석만 제공)']
  ai_term_ko     varchar(100) [note: '신규 판교어일 때 AI가 정한 용어명 (term_id NULL일 때만)']
  ai_plain_ko    varchar(200) [note: '신규 판교어일 때 AI 쉬운 말 (term_id NULL일 때만)']
  matched_text   varchar(100) [not null, note: '원문에서 매칭된 문자열']
  start_index    int          [not null, note: '하이라이트 시작 위치']
  end_index      int          [not null, note: '하이라이트 끝 위치']
  confidence     decimal(4,3) [not null, note: 'AI 신뢰도 0.000~1.000']

  indexes {
    translation_id [name: 'ix_tt_translation']
    term_id [name: 'ix_tt_term']
  }
  Note: 'M:N (translations <-> terms) + 위치 속성. 노란 형광펜과 용어 칩의 원천'
}

Table meeting_recordings {
  id                 bigint           [pk, increment]
  user_id            bigint           [not null]
  meeting_id         bigint           [not null, note: '녹음은 항상 회의 안에서']
  translation_id     bigint           [unique, note: '변환, 해석이 끝나면 연결 (1:1)']
  audio_url          varchar(500)     [note: '원본 음성 - 보관기간 후 NULL']
  duration_sec       int              [not null]
  consent_confirmed  boolean          [not null, note: '참석자 녹음 고지 확인 - false면 저장 거부(400)']
  status             recording_status [not null, default: 'RECORDING', note: '첫 조각 업로드 시 RECORDING으로 생성']
  progress           int              [not null, default: 0, note: '변환 진행률 0~100 (W-02, W-04 3초 폴링)']
  transcript         text             [note: '변환된 회의록 텍스트 - 녹음 중에는 부분 텍스트']
  failure_reason     varchar(200)     [note: 'status=FAILED 일 때 원인']
  expires_at         datetime         [not null, note: '음성 파일 자동 삭제 시점 (기본 30일)']
  created_at         datetime         [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'ix_recordings_user_time']
    meeting_id [name: 'ix_recordings_meeting']
  }
  Note: '회의 녹음 (W-02a, W-02, A-12). 변환 완료 시 translations(source_type=MEETING_NOTE, input_source=RECORDING) 생성'
}

// ==========================================
// Push & Notification (웹, 앱은 같은 DB, 푸시는 iOS)
// ==========================================

Table user_devices {
  id          bigint          [pk, increment]
  user_id     bigint          [not null]
  platform    device_platform [not null]
  push_token  varchar(255)    [note: 'APNs 토큰 (IOS만)']
  last_seen_at datetime       [not null, default: `now()`, note: '마지막으로 푸시 토큰을 확인한 시각']
  created_at  datetime        [not null, default: `now()`]

  indexes {
    (user_id, platform) [name: 'ix_devices_user_platform']
    push_token [unique, name: 'ux_devices_token']
  }
  Note: '1:N - iOS 푸시 토큰 보관 용도 (기기 연결, 동기화 아님). 알림은 IOS 기기로 발송'
}

Table notifications {
  id             bigint            [pk, increment]
  user_id        bigint            [not null]
  type           notification_type [not null]
  title          varchar(100)      [not null, note: '"얼라인, 기억나세요?"']
  body           varchar(300)      [not null]
  target_id      bigint            [note: '연결 대상 - review_session / translation_action / translation']
  scheduled_at   datetime          [not null, note: '발송 예정']
  sent_at        datetime
  created_at     datetime          [not null, default: `now()`]

  indexes {
    (user_id, scheduled_at) [name: 'ix_noti_user_time']
  }
  Note: 'iOS 시스템 알림 발송 기록 (A-02 잠금화면, A-05 알림 센터). 인앱 알림함 화면이 없어 조회 API 없음'
}

// ==========================================
// Exam (판교어 실력 테스트)
// ==========================================

Table quiz_sessions {
  id             bigint      [pk, increment]
  user_id        bigint      [not null]
  question_count int         [not null, default: 5, note: '기본 5문제 (퇴근길 3분 분량)']
  correct_count  int         [not null, default: 0]
  score          int         [not null, default: 0, note: '0~100']
  level_code     varchar(20) [note: '이번 응시로 받은 등급']
  started_at     datetime    [not null, default: `now()`]
  finished_at    datetime    [note: 'NULL = 진행 중']

  indexes {
    (user_id, started_at) [name: 'ix_quiz_user_time']
  }
  Note: '판교어 실력 테스트 응시 1회 = 1행 (A-07, A-08)'
}

Table quiz_questions {
  id              bigint       [pk, increment]
  quiz_session_id bigint       [not null]
  term_id         bigint       [not null, note: '출제된 용어']
  question_text   varchar(300) [not null]
  choices         json         [not null, note: '보기 4개 배열 - AI 생성 오답 포함']
  answer_index    int          [not null, note: '정답 보기 번호 0~3']
  selected_index  int          [note: '사용자가 고른 번호 (NULL = 미응답)']
  is_correct      boolean      [not null, default: false]
  sort_order      int          [not null, note: '문항 순서 1~5']

  indexes {
    (quiz_session_id, sort_order) [unique, name: 'ux_quiz_q_order']
    term_id [name: 'ix_quiz_q_term']
  }
  Note: '1:N - 세션 하나에 문항 5개. 오답은 카드로 담아 복습으로 연결'
}

// ==========================================
// Relationships (관계 정의)
// ==========================================

// 1:N
Ref: users.level_code > levels.code            // 등급 마스터 참조
Ref: terms.created_by > users.id               // 운영자 1 : 용어 N
Ref: terms.reviewed_by > users.id              // 운영자 1 : 검수 용어 N
Ref: term_examples.term_id > terms.id          // 용어 1 : 예문 N
Ref: term_examples.created_by > users.id
Ref: review_sessions.user_id > users.id        // 사용자 1 : 복습세션 N
Ref: review_logs.review_session_id > review_sessions.id  // 세션 1 : 복습로그 N
Ref: review_logs.card_id > cards.id            // 카드 1 : 복습로그 N
Ref: translations.user_id > users.id
Ref: translation_terms.translation_id > translations.id    // 해석 1 : 탐지용어 N
Ref: translation_actions.translation_id > translations.id  // 해석 1 : 할 일 N
Ref: projects.user_id > users.id
Ref: translations.project_id > projects.id
Ref: meetings.project_id > projects.id
Ref: meetings.user_id > users.id
Ref: translations.meeting_id > meetings.id
Ref: meeting_recordings.meeting_id > meetings.id
Ref: cards.source_translation_id > translations.id
Ref: users.current_project_id > projects.id
Ref: meeting_recordings.user_id > users.id

// 1:1
Ref: meeting_recordings.translation_id - translations.id   // 녹음 1 : 해석 1

// 1:N (계속)
Ref: user_devices.user_id > users.id                       // 사용자 1 : 기기 N
Ref: notifications.user_id > users.id                      // 사용자 1 : 알림 N
Ref: quiz_sessions.user_id > users.id
Ref: quiz_sessions.level_code > levels.code
Ref: quiz_questions.quiz_session_id > quiz_sessions.id   // 테스트 1 : 문항 N
Ref: quiz_questions.term_id > terms.id

// M:N (교차 테이블)
Ref: cards.user_id > users.id                  // users <-> terms (학습 카드)
Ref: cards.term_id > terms.id
Ref: translation_terms.term_id > terms.id      // translations <-> terms (탐지 용어)
