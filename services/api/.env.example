# 키 이름 견본. 값은 넣지 않는다 (공개 저장소). 실제 값은 services/api/.env(무시됨) 또는 prod sops.
MWONMAL_ENV=local
MWONMAL_DATABASE_URL=mysql+aiomysql://root:local@127.0.0.1:3306/mwonmal?charset=utf8mb4

# 우리 액세스 토큰 RS256 개인키(PEM). local·test 는 비워 두면 임시 키.
MWONMAL_JWT_PRIVATE_KEY=
MWONMAL_JWT_KID=local-1

# Sign in with Apple (ADR-0014). Apple Developer → Keys 에서 만든 .p8 내용, Key ID, Team ID.
MWONMAL_APPLE_CLIENT_ID=kr.mwonmal.app
MWONMAL_APPLE_TEAM_ID=
MWONMAL_APPLE_KEY_ID=
MWONMAL_APPLE_PRIVATE_KEY=

# 로컬 E2E 전용 가짜 로그인(code="dev:<이름>"). local·test 에서만 켜진다. scripts/dev_server.py 가 켠다.
MWONMAL_DEV_LOGIN=0
# 한도 카운터·브레이커 공유. 비면 프로세스 메모리(local·test 만).
MWONMAL_REDIS_URL=

# AI 외부 전송(ADR-0008). 기본 꺼짐 → 사전 간이 해석만. 켜도 사용자가 옵트인(X-Mw-AI-Consent: 1)한 요청만.
MWONMAL_AI_EXTERNAL_TEXT=0
MWONMAL_GEMINI_API_KEY=
MWONMAL_GEMINI_MODEL=gemini-2.5-flash

# 문맥 판교어 탐지기(글자 CRF, ADR-0023). 서버 안에서만 돈다. 0 이면 사전만(이전과 같은 결과).
MWONMAL_JARGON_MODEL=1
MWONMAL_JARGON_MODEL_THRESHOLD=0.9
