# 키 이름 견본. 값은 넣지 않는다 (공개 저장소). 실제 값은 services/api/.env(무시됨) 또는 prod sops.
MWONMAL_ENV=local
MWONMAL_DATABASE_URL=mysql+aiomysql://root:local@127.0.0.1:3306/mwonmal?charset=utf8mb4

# 우리 액세스 토큰 RS256 개인키(PEM). local·test 는 비워 두면 임시 키.
MWONMAL_JWT_PRIVATE_KEY=
MWONMAL_JWT_KID=local-1

# Sign in with Apple (ADR-0014). Apple Developer → Keys 에서 만든 .p8 내용, Key ID, Team ID.
MWONMAL_APPLE_CLIENT_ID=kr.mwonmal.app
MWONMAL_APPLE_TEAM_ID=
MWONMAL_APPLE_KEY_ID=
MWONMAL_APPLE_PRIVATE_KEY=
