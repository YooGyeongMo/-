{
  "sourceLanguage": "ko",
  "strings": {
    "home.actions.toggleFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 바꾸지 못했어요. 잠시 후 다시 해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't update the task. Please try again."
          }
        }
      }
    },
    "home.review.comingSoon": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퇴근길 복습은 다음 업데이트에서 열려요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening review is coming in the next update."
          }
        }
      }
    },
    "my.link.reviewComingSoon": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습 알림 시간은 다음 업데이트에서 바꿀 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change the review time in the next update."
          }
        }
      }
    },
    "review.comingSoon.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해석하면서 만난 모르는 말을 카드로 모아\n퇴근길 3분 복습을 시켜 드릴게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown terms from your decodes will become cards\nfor a 3-minute evening review."
          }
        }
      }
    },
    "review.comingSoon.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습은 다음 업데이트에서 열려요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review is coming in the next update"
          }
        }
      }
    },
    "session.expired": {
