    "home.actions.empty": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 할 일이 없어요.\n받은 메시지를 붙여넣으면 할 일을 뽑아 드려요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks yet.\nPaste a message and we'll pull out your tasks."
          }
        }
      }
    },
