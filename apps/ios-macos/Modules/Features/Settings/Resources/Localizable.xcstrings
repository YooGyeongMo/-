    "settings.consent.agree": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽었어요, 켤게요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand, turn it on"
          }
        }
      }
    },
    "settings.consent.cancel": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그대로 둘게요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it off"
          }
        }
      }
    },
    "settings.consent.point1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해석할 문장만 무료 AI 제공자(Google Gemini)에 보내요. 이름·이메일·프로젝트·회의 제목은 보내지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the message text goes to a free AI provider (Google Gemini). No names, emails, projects or meeting titles."
          }
        }
      }
    },
    "settings.consent.point2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 이용 조건에 따라 제공자가 보낸 문장을 서비스 개선에 쓰거나 사람이 검토할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under the free terms, the provider may use the text to improve its service and people may review it."
          }
        }
      }
    },
    "settings.consent.point3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회사 기밀·개인정보가 담긴 문장은 보내지 마세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't send confidential or personal information."
          }
        }
      }
    },
    "settings.consent.point4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 그 뒤로는 사전으로만 해석해요. 로그아웃하면 자동으로 꺼져요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off anytime to go back to dictionary-only. Signing out turns it off."
          }
        }
      }
    },
    "settings.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 외부 전송을 켤까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on AI sharing?"
          }
        }
      }
    },
