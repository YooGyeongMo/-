    "settings.ai.footnote": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 해석할 문장만 무료 AI 제공자(Google Gemini)에 보내요. 이름·프로젝트·회의 정보는 보내지 않아요. 언제든 끌 수 있고, 로그아웃하면 다시 꺼져요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, only the message text is sent to a free AI provider (Google Gemini). No names, projects or meeting info. Turn it off anytime; signing out turns it off."
          }
        }
      }
    },
    "settings.ai.off": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐 · 사전으로 간이 해석해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off · Dictionary-only decoding"
          }
        }
      }
    },
    "settings.ai.on": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜짐 · 뉘앙스·할 일까지 자세히 해석해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On · Richer nuance and tasks"
          }
        }
      }
    },
    "settings.ai.section": {
